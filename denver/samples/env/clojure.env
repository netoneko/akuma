# Clojure 1.12.0 (+ spec.alpha 0.5.238, core.specs.alpha 0.4.74), jars in /opt/clojure. Installed as /etc/clojure.env.
. /etc/java.env
CLOJURE_HOME=/opt/clojure; export CLOJURE_HOME
CLOJURE_CP=$CLOJURE_HOME/clojure-1.12.0.jar:$CLOJURE_HOME/spec.alpha-0.5.238.jar:$CLOJURE_HOME/core.specs.alpha-0.4.74.jar; export CLOJURE_CP
