# The Java environment inside a denver guest (JDK 21.0.13, Alpine build at /opt/jdk). Installed as /etc/java.env.
#
# Sourced by /etc/profile and by every wrapper in /usr/local/bin (javac, clojure, scalac, scala, groovy):
# sshd sets no environment for a session, so nothing here may be assumed already set (same rule as
# scripts/box/akuma-dev.env). The guest has no `javac` launcher: the compiler is the jdk.compiler module's main class,
# which the javac wrapper starts.
HOME=${HOME:-/root}; export HOME
JAVA_HOME=/opt/jdk; export JAVA_HOME
PATH=/usr/local/bin:$JAVA_HOME/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin; export PATH
# Heap for tools that do not set their own; -Xmx per wrapper overrides. 3 GiB guest.
JAVA_OPTS_DEFAULT="-Xmx1g"; export JAVA_OPTS_DEFAULT
