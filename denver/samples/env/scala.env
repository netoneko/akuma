# Scala 2.13.14 (compiler, library, reflect), jars in /opt/scala. Installed as /etc/scala.env.
. /etc/java.env
SCALA_HOME=/opt/scala; export SCALA_HOME
SCALA_LIB=$SCALA_HOME/scala-library-2.13.14.jar; export SCALA_LIB
SCALA_CP=$SCALA_HOME/scala-compiler-2.13.14.jar:$SCALA_LIB:$SCALA_HOME/scala-reflect-2.13.14.jar; export SCALA_CP
