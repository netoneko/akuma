[submodule "userspace/meow"]
	path = userspace/meow
	url = https://github.com/netoneko/meow.git
[submodule "userspace/tcc/tinycc"]
	path = userspace/tcc/tinycc
	url = https://repo.or.cz/tinycc.git
[submodule "userspace/llama.cpp/llama.cpp"]
	path = userspace/llama.cpp/llama.cpp
	url = https://github.com/netoneko/llama.cpp.git
[submodule "userspace/nca/native-cli-ai"]
	path = userspace/nca/native-cli-ai
	url = https://github.com/netoneko/native-cli-ai.git
[submodule "userspace/rumpkernel/buildrump.sh"]
	path = userspace/rumpkernel/buildrump.sh
	url = https://github.com/netoneko/buildrump.sh.git
[submodule "userspace/rumpkernel/sic"]
	path = userspace/rumpkernel/sic
	url = https://github.com/netoneko/sic.git
[submodule "userspace/rumpkernel/src-netbsd"]
	path = userspace/rumpkernel/src-netbsd
	url = https://github.com/netoneko/src-netbsd.git
	branch = akuma-integration
[submodule "crates/akuma-fbcon/vendor/spleen"]
	path = crates/akuma-fbcon/vendor/spleen
	url = https://github.com/fcambus/spleen
[submodule "crates/akuma-fbcon/vendor/jetbrains-mono"]
	path = crates/akuma-fbcon/vendor/jetbrains-mono
	url = https://github.com/JetBrains/JetBrainsMono
	# One file is used (fonts/ttf/JetBrainsMono-Regular.ttf, baked into a cell
	# table by crates/akuma-fbcon/build.rs) out of a repo whose full history is
	# ~29 MiB of font binaries. A shallow checkout is 10 MiB of .git and has
	# the file; nothing here ever reads this submodule's log.
	shallow = true
