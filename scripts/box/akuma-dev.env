# The Akuma/amd64 development environment on the bare-metal box ("the trashcan").
#
# Sourced by /etc/profile and by /bin/{kbuild,ubuild,mbuild,kinstall}. sshd sets
# no environment at all for a session (userspace/sshd/src/protocol.rs: TERM only,
# and only with a pty), so nothing here can be assumed to be set already — every
# wrapper sources this file rather than trusting the caller.
#
# LD_LIBRARY_PATH is MANDATORY for rustc: it is a 9 KB shim over
# librustc_driver-*.so found through DT_RUNPATH `$ORIGIN/../lib`, and musl
# expands $ORIGIN by reading /proc/self/exe, which this kernel does not have.
# Without it: "Error loading shared library librustc_driver-….so".
HOME=${HOME:-/root}; export HOME
PATH=/usr/local/bin:/usr/local/rust/bin:/usr/bin:/bin; export PATH
LD_LIBRARY_PATH=/usr/local/rust/lib:/usr/lib:/lib; export LD_LIBRARY_PATH
CARGO_HOME=${CARGO_HOME:-$HOME/.cargo}; export CARGO_HOME
AKUMA_SRC=${AKUMA_SRC:-/src/github.com/netoneko/akuma}; export AKUMA_SRC
