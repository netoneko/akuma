#!/bin/sh
# Run clippy and tests on all extracted crates before committing.
# Uses the host target so tests/clippy work outside QEMU.

# Only what cargo compiles needs clippy and the tests. A commit whose staged paths contain no Rust source,
# manifest, lockfile, build script, toolchain/cargo config, linker script or assembly (docs, scripts, shell, Python,
# images, userspace C...) cannot change what they see: skip the run. FORCE_HOOK=1 runs it anyway.
if [ -z "$FORCE_HOOK" ] && ! git diff --cached --name-only | grep -qE '\.(rs|toml|lock|ld|s|S)$|(^|/)build\.rs$|(^|/)rust-toolchain|(^|/)\.cargo/'; then
    echo "pre-commit: no Rust-affecting paths staged, skipping clippy and tests"
    exit 0
fi

HOST_TARGET="$(rustc -vV | grep '^host:' | cut -d' ' -f2)"

# Console-print rule (CLAUDE.md § "Kernel conventions", docs/reference/subsystems/
# console.md § "Printing rules"): no heap allocation on any path that ends at the
# console. Two cheap, high-confidence greps for the two worst violation shapes;
# both are full-tree, matching the clippy loop below.

# user-pointer ratchet (TYPE_SYSTEM_SAFETY_REPORT.md section 8): a new handler takes `UserAddr`, not a bare u64.
echo "user-pointer ratchet: no new untyped *_ptr parameters"
if [ -x scripts/check_user_ptr_params.py ]; then
    scripts/check_user_ptr_params.py || exit 1
fi

echo "console-print rule: no reimplemented core::fmt::Write writers"
VIOLATIONS="$(grep -rnE 'impl(<[^>]*>)? core::fmt::Write for' src/ crates/*/src/ --include='*.rs' \
    | grep -v '^crates/akuma-primitives/src/console\.rs:')"
if [ -n "$VIOLATIONS" ]; then
    echo "$VIOLATIONS"
    echo "ERROR: hand-rolled core::fmt::Write writer outside crates/akuma-primitives/src/console.rs."
    echo "Reuse console::StackWriter / process::FmtBuf instead — see docs/reference/subsystems/console.md § \"Printing rules\"."
    exit 1
fi

echo "console-print rule: no format!/alloc::format! feeding a console print call"
VIOLATIONS="$(grep -rnE '(print_str|safe_print!|tprint!|console::print)[!(].*(format!|alloc::format!)' src/ crates/*/src/ --include='*.rs' \
    | grep -vE '^(src|crates/akuma-kernel-tests-aarch64/src)/(tests|process_tests|shell_tests)\.rs:')"
if [ -n "$VIOLATIONS" ]; then
    echo "$VIOLATIONS"
    echo "ERROR: format!/alloc::format! result passed into a console print call — heap allocation on a console path."
    echo "Format directly into the print macro's args, or a console::StackWriter/process::FmtBuf, instead — see docs/reference/subsystems/console.md § \"Printing rules\"."
    exit 1
fi

for crate in crates/*/; do
    name="$(basename "$crate")"
    # The amd64 machine half is x86_64-only by design (a `compile_error!` on any
    # other arch); it is linted below for its own target instead.
    case "$name" in akuma-kernel-amd64) continue ;; esac
    echo "clippy: $name"
    # akuma-psci is `smc`/`hvc` assembly end to end: it only assembles for AArch64, so on an
    # x86_64 host it is linted for the kernel's own target instead.
    target="$HOST_TARGET"
    case "$name" in akuma-psci) target=aarch64-unknown-none ;; esac
    # akuma-kernel-glue needs the root kernel's feature set to build at all; the root clippy below lints it.
    case "$HOST_TARGET:$name" in aarch64-*:*) ;; *:akuma-kernel-glue) continue ;; esac
    cargo clippy -p "$name" --target "$target" -- -D warnings || exit 1
done

echo "clippy: akuma (amd64, headless)"
cargo clippy -p akuma --target x86_64-unknown-none --release \
    --no-default-features --features headless -- -D warnings || exit 1

echo "clippy: akuma (release)"
cargo clippy --release -- -D warnings || exit 1

# A build without the default features (no syscall families, no sound), under
# the size-optimised profile: the configuration the default set never compiles.
echo "clippy: akuma (extreme-size profile, --no-default-features)"
cargo clippy --profile extreme-size --no-default-features \
    --features no-tests,smoltcp -- -D warnings || exit 1

# Platform kernels (taoxichuan, shanghai, denver) share akuma-syscalls-glue, akuma-exec and
# akuma-tokio-kernel-core with the main kernel, so a signature change there breaks them with no
# other signal (docs/archive/HOW_MAIN_BROKE_2026_11.md). They cannot sit in `default-members`: cargo
# unifies features across one resolve and that breaks akuma-kernel-tests-aarch64. So each is checked
# on its own, on both architectures (`cargo check`, not a full build; premerge_build.sh builds them).
# Set SKIP_PLATFORM_KERNELS=1 to skip (e.g. a docs-adjacent change).
if [ -z "$SKIP_PLATFORM_KERNELS" ]; then
    for k in taoxichuan shanghai denver; do
        for t in aarch64-unknown-none x86_64-unknown-none; do
            echo "check: $k ($t)"
            cargo check -p "$k" --target "$t" || exit 1
        done
    done
fi

echo "tests"
# Per crate, because the AArch64 kernel-side crates only compile on an AArch64 host. On any other
# host (x86_64 Linux) they are skipped here; their clippy ran above and premerge_build.sh builds them.
for crate in crates/*/; do
    name="$(basename "$crate")"
    case "$name" in akuma-kernel-amd64) continue ;; esac
    case "$HOST_TARGET" in
        aarch64-*) ;;
        *) case "$name" in akuma-kernel-glue|akuma-boot-amd64) continue ;; esac ;;
    esac
    cargo test -p "$name" --target "$HOST_TARGET" || exit 1
done

# akuma-ssh-crypto moved to userspace/ (its only consumer is userspace/sshd), so
# the crates/*/ loop above no longer reaches it.
echo "clippy+tests: akuma-ssh-crypto (userspace)"
(cd userspace && cargo clippy -p akuma-ssh-crypto --target "$HOST_TARGET" -- -D warnings) || exit 1
(cd userspace && cargo test -p akuma-ssh-crypto --target "$HOST_TARGET") || exit 1
